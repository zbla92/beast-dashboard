# Whisper for Beast Dash — copy to whisper/whisper.env and adjust. Sourced by whisper/run.sh (bash): keep values in single quotes.
# Model: large-v3-turbo is the best speed/quality on a GPU; on CPU use small or medium.
WHISPER_MODEL='large-v3-turbo'
# auto = CUDA when an NVIDIA GPU is there, else CPU (int8)
WHISPER_DEVICE='auto'
# Languages you speak, for auto-detection (leave empty to let Whisper pick any language). Also set
# "voiceLangs" in the dashboard settings to get a language toggle on the recording sheet.
#WHISPER_LANGS='en,de'
# Words / names / jargon that help spelling
#WHISPER_PROMPT='Claude, Kubernetes, pull request, deploy'
# Words it keeps mishearing: regex=>replacement, separated by ;;
#WHISPER_FIXES='\bcloud code\b=>Claude Code'
# Seconds without work before the service exits and frees the GPU (it starts again on the next recording)
WHISPER_IDLE_EXIT='60'
