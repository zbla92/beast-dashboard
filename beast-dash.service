[Unit]
Description=Beast Dash — dev dashboard (projects, processes, docker, tunnels)
After=network-online.target tailscaled.service docker.service
Wants=network-online.target

[Service]
Type=simple
# Template: install.sh fills in the node dir and the repo path and copies this to ~/.config/systemd/user/.
WorkingDirectory=__REPO__
Environment=PATH=__NODE_DIR__:%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=NODE_ENV=production
ExecStart=__NODE_DIR__/node __REPO__/server.js
Restart=always
RestartSec=2
KillMode=process

[Install]
WantedBy=default.target
